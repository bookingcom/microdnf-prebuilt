load("//microdnf/private:platforms.bzl", "SUPPORTED_PLATFORMS")

package(default_visibility = ["//visibility:public"])

exports_files([
    "MODULE.bazel",
    "go.mod",
])

filegroup(
    name = "microdnf_module_files",
    srcs = [
        ":tools_archive",
        "BUILD.bazel",
        "MODULE.bazel",
        "//microdnf:all_files",
        "//microdnf/private:all_files",
    ],
    visibility = ["//visibility:public"],
)

TARGETS = [
    "microdnf",
    "rpm2archive",
    "dnf_lock",
]

[
    alias(
        name = target,
        actual = select({
            "//microdnf:is_" + platform: "//dnf:{}_{}".format(target, platform)
            for platform in SUPPORTED_PLATFORMS
        }),
    )
    for target in TARGETS
]

[
    alias(
        name = "{}_{}".format(target, platform),
        actual = "//dnf:{}_{}".format(target, platform),
    )
    for target in TARGETS
    for platform in SUPPORTED_PLATFORMS
]

[
    alias(
        name = target + "_all",
        actual = "//dnf:" + target + "_all",
    )
    for target in TARGETS
]

alias(
    name = "rpm2files",
    actual = select({
        "//microdnf:is_" + platform: "//dnf:rpm2files_" + platform
        for platform in SUPPORTED_PLATFORMS
    }),
)

[
    alias(
        name = "rpm2files_" + platform,
        actual = "//dnf:rpm2files_" + platform,
    )
    for platform in SUPPORTED_PLATFORMS
]

alias(
    name = "rpm2files_all",
    actual = "//dnf:rpm2files_all",
)

genrule(
    name = "tools_archive",
    srcs = [
        ":dnf_lock",
        ":microdnf",
        ":rpm2archive",
        ":rpm2files",
    ],
    outs = ["microdnf_tools.tar.gz"],
    cmd = """
TMP_DIR=$$(mktemp -d)
trap 'rm -rf "$$TMP_DIR"' EXIT
for f in $(locations :dnf_lock); do
  if [ -f "$$f" ] && [ -x "$$f" ]; then
    cp -L "$$f" "$$TMP_DIR/dnf_lock"
    cp -L "$$f" "$$TMP_DIR/lock"
  fi
done
for f in $(locations :microdnf); do
  if [ -f "$$f" ] && [ -x "$$f" ]; then
    cp -L "$$f" "$$TMP_DIR/microdnf"
  fi
done
for f in $(locations :rpm2archive); do
  if [ -f "$$f" ] && [ -x "$$f" ]; then
    cp -L "$$f" "$$TMP_DIR/rpm2archive"
  fi
done
for f in $(locations :rpm2files); do
  if [ -f "$$f" ] && [ -x "$$f" ]; then
    cp -L "$$f" "$$TMP_DIR/rpm2files"
  fi
done
tar -czf $@ -C "$$TMP_DIR" dnf_lock lock microdnf rpm2archive rpm2files
""",
)
