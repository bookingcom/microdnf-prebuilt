load("//microdnf/private:platforms.bzl", "SUPPORTED_PLATFORMS")

package(default_visibility = ["//visibility:public"])

exports_files([
    "defs.bzl",
    "extensions.bzl",
])

TARGETS = [
    "microdnf",
    "rpm2archive",
    "dnf_lock",
]

[
    alias(
        name = target,
        actual = "//dnf:" + target,
    )
    for target in TARGETS
]

[
    alias(
        name = "{}_{}".format(target, platform),
        actual = "//dnf:{}_{}".format(target, platform),
    )
    for target in TARGETS
    for platform in SUPPORTED_PLATFORMS
]

[
    alias(
        name = target + "_all",
        actual = "//dnf:" + target + "_all",
    )
    for target in TARGETS
]

genrule(
    name = "tools_archive",
    srcs = [
        "//:dnf_lock",
        "//:rpm2archive",
        "//:microdnf",
    ],
    outs = ["microdnf_tools.tar.gz"],
    cmd = """
        TMP=$$(mktemp -d)
        cp $(location //:dnf_lock) $$TMP/dnf_lock
        cp $(location //:dnf_lock) $$TMP/lock
        cp $(location //:rpm2archive) $$TMP/rpm2archive
        cp $(location //:microdnf) $$TMP/microdnf
        chmod 0755 $$TMP/dnf_lock $$TMP/lock $$TMP/rpm2archive $$TMP/microdnf
        tar -czf $@ -C $$TMP dnf_lock lock rpm2archive microdnf
        rm -rf $$TMP
    """,
)


