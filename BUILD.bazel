load("//microdnf/private:platforms.bzl", "SUPPORTED_PLATFORMS")

package(default_visibility = ["//visibility:public"])

exports_files([
    "MODULE.bazel",
])

filegroup(
    name = "microdnf_module_files",
    srcs = [
        ":tools_archive",
        "BUILD.bazel",
        "MODULE.bazel",
        "//microdnf:all_files",
        "//microdnf/private:all_files",
    ],
    visibility = ["//visibility:public"],
)

TARGETS = [
    "microdnf",
    "rpm2archive",
    "dnf_lock",
]

[
    alias(
        name = target,
        actual = "//dnf:" + target,
    )
    for target in TARGETS
]

[
    alias(
        name = "{}_{}".format(target, platform),
        actual = "//dnf:{}_{}".format(target, platform),
    )
    for target in TARGETS
    for platform in SUPPORTED_PLATFORMS
]

[
    alias(
        name = target + "_all",
        actual = "//dnf:" + target + "_all",
    )
    for target in TARGETS
]

genrule(
    name = "tools_archive",
    srcs = [
        ":dnf_lock",
        ":microdnf",
        ":rpm2archive",
    ],
    outs = ["microdnf_tools.tar.gz"],
    cmd = """
TMP_DIR=$$(mktemp -d)
trap 'rm -rf "$$TMP_DIR"' EXIT
cp $(location :dnf_lock) "$$TMP_DIR/dnf_lock"
cp $(location :dnf_lock) "$$TMP_DIR/lock"
cp $(location :microdnf) "$$TMP_DIR/microdnf"
cp $(location :rpm2archive) "$$TMP_DIR/rpm2archive"
tar -czf $@ -C "$$TMP_DIR" dnf_lock lock microdnf rpm2archive
""",
)
