load("@tar.bzl", "tar")
load("//microdnf/private:platforms.bzl", "SUPPORTED_PLATFORMS")

package(default_visibility = ["//visibility:public"])

exports_files([
    "MODULE.bazel",
    "go.mod",
])

filegroup(
    name = "microdnf_module_files",
    srcs = [
        ":tools_archive",
        "BUILD.bazel",
        "MODULE.bazel",
        "//microdnf:all_files",
        "//microdnf/private:all_files",
    ],
    visibility = ["//visibility:public"],
)

TARGETS = [
    "microdnf",
    "rpm2archive",
    "dnf_lock",
    "mark",
]

[
    alias(
        name = target,
        actual = select({
            "//microdnf:is_" + platform: "//dnf:{}_{}".format(target, platform)
            for platform in SUPPORTED_PLATFORMS
        }),
    )
    for target in TARGETS
]

[
    alias(
        name = "{}_{}".format(target, platform),
        actual = "//dnf:{}_{}".format(target, platform),
    )
    for target in TARGETS
    for platform in SUPPORTED_PLATFORMS
]

[
    alias(
        name = target + "_all",
        actual = "//dnf:" + target + "_all",
    )
    for target in TARGETS
]

alias(
    name = "rpm2files",
    actual = select({
        "//microdnf:is_" + platform: "//dnf:rpm2files_" + platform
        for platform in SUPPORTED_PLATFORMS
    }),
)

[
    alias(
        name = "rpm2files_" + platform,
        actual = "//dnf:rpm2files_" + platform,
    )
    for platform in SUPPORTED_PLATFORMS
]

alias(
    name = "rpmdb-mark",
    actual = ":mark",
)

alias(
    name = "rpm2files_all",
    actual = "//dnf:rpm2files_all",
)

tar(
    name = "tools_archive",
    srcs = [
        ":dnf_lock",
        ":mark",
        ":microdnf",
        ":rpm2archive",
        ":rpm2files",
    ],
    mtree = [
        "dnf_lock uid=0 gid=0 mode=0755 time=0 type=file content=$(location :dnf_lock)",
        "lock uid=0 gid=0 mode=0755 time=0 type=link link=dnf_lock",
        "mark uid=0 gid=0 mode=0755 time=0 type=file content=$(location :mark)",
        "rpmdb-mark uid=0 gid=0 mode=0755 time=0 type=link link=mark",
        "microdnf uid=0 gid=0 mode=0755 time=0 type=file content=$(location :microdnf)",
        "rpm2archive uid=0 gid=0 mode=0755 time=0 type=file content=$(location :rpm2archive)",
        "rpm2files uid=0 gid=0 mode=0755 time=0 type=file content=$(location :rpm2files)",
    ],
    out = "microdnf_tools.tar.gz",
    compress = "gzip",
)
