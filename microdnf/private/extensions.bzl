"""Bzlmod extension for declaring prebuilt microdnf binaries and host alias repositories."""

load("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")
load("//microdnf/private:integrities.bzl", "BASE_URL", "INTEGRITIES")

def _detect_platform(rctx):
    os_name = rctx.os.name.lower()
    if os_name.startswith("linux"):
        os = "linux"
    elif os_name.startswith("mac") or os_name.startswith("darwin"):
        os = "osx"
    else:
        fail("Unsupported operating system: " + os_name)

    arch = rctx.os.arch.lower()
    if arch in ["x86_64", "amd64"]:
        cpu = "amd64"
    elif arch in ["aarch64", "arm64"]:
        cpu = "arm64"
    else:
        fail("Unsupported architecture: " + arch)

    return os + "_" + cpu

def _microdnf_host_alias_repo_impl(rctx):
    platform = _detect_platform(rctx)
    rctx.file("BUILD.bazel", """# @generated by microdnf-prebuilt
package(default_visibility = ["//visibility:public"])

alias(
    name = "microdnf",
    actual = "@microdnf_{platform}//file",
)
""".format(platform = platform))

microdnf_host_alias_repo = repository_rule(
    implementation = _microdnf_host_alias_repo_impl,
    doc = "Creates a repository for the host platform providing @microdnf//:microdnf",
)

def _rpm2archive_host_alias_repo_impl(rctx):
    platform = _detect_platform(rctx)
    rctx.file("BUILD.bazel", """# @generated by microdnf-prebuilt
package(default_visibility = ["//visibility:public"])

alias(
    name = "rpm2archive",
