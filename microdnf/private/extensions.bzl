def _dnf_lock_host_alias_repo_impl(rctx):
    platform = _detect_platform(rctx)
    rctx.file("BUILD.bazel", """# @generated by microdnf-prebuilt
package(default_visibility = ["//visibility:public"])

alias(
    name = "dnf_lock",
    actual = "@dnf_lock_{platform}//file",
