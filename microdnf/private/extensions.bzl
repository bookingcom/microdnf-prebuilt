""".format(platform = platform))

dnf_lock_host_alias_repo = repository_rule(
    implementation = _dnf_lock_host_alias_repo_impl,
    doc = "Creates a repository for the host platform providing @dnf_lock//:dnf_lock",
)

def _microdnf_prebuilt_extension_impl(module_ctx):
    for name, integrity in INTEGRITIES.items():
        http_file(
            name = name,
            url = BASE_URL + "/" + name,
            integrity = integrity,
            executable = True,
        )

    microdnf_host_alias_repo(name = "microdnf")
    rpm2archive_host_alias_repo(name = "rpm2archive")
    dnf_lock_host_alias_repo(name = "dnf_lock")

microdnf_prebuilt_extension = module_extension(
    implementation = _microdnf_prebuilt_extension_impl,
)
