load("//microdnf/private:platforms.bzl", "SUPPORTED_PLATFORMS")
load("//microdnf/private:toolchain.bzl", "microdnf_toolchain")

package(default_visibility = ["//visibility:public"])

exports_files([
    "defs.bzl",
    "extension.bzl",
    "extensions.bzl",
    "prebuilt.bzl",
])

filegroup(
    name = "all_files",
    srcs = glob(["*"]),
)

toolchain_type(
    name = "toolchain_type",
    visibility = ["//visibility:public"],
)

PLATFORM_CONSTRAINTS = {
    "linux_amd64": [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    "linux_arm64": [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
    "osx_amd64": [
        "@platforms//os:osx",
        "@platforms//cpu:x86_64",
    ],
    "osx_arm64": [
        "@platforms//os:osx",
        "@platforms//cpu:aarch64",
    ],
}

[
    config_setting(
        name = "is_" + platform,
        constraint_values = PLATFORM_CONSTRAINTS[platform],
    )
    for platform in SUPPORTED_PLATFORMS
]

alias(
    name = "rpm2archive",
    actual = select({
        ":is_" + platform: "@rpm2archive_" + platform + "//file"
        for platform in SUPPORTED_PLATFORMS
    }),
    visibility = ["//visibility:public"],
)

# Host toolchain implementation selects the prebuilt binary matching host platform
microdnf_toolchain(
    name = "toolchain_impl_host",
    dnf_lock = select({
        ":is_" + platform: "@dnf_lock_" + platform + "//file"
        for platform in SUPPORTED_PLATFORMS
    }),
    microdnf = select({
        ":is_" + platform: "@microdnf_" + platform + "//file"
        for platform in SUPPORTED_PLATFORMS
    }),
    rpm2archive = select({
        ":is_" + platform: "@rpm2archive_" + platform + "//file"
        for platform in SUPPORTED_PLATFORMS
    }),
)

toolchain(
    name = "toolchain_host",
    toolchain = ":toolchain_impl_host",
    toolchain_type = ":toolchain_type",
    visibility = ["//visibility:public"],
)

# Platform-specific toolchain implementations binding to http_file prebuilt binaries
[
    microdnf_toolchain(
        name = "toolchain_impl_" + platform,
        dnf_lock = "@dnf_lock_" + platform + "//file",
        microdnf = "@microdnf_" + platform + "//file",
        rpm2archive = "@rpm2archive_" + platform + "//file",
    )
    for platform in SUPPORTED_PLATFORMS
]

[
    toolchain(
        name = "toolchain_" + platform,
        exec_compatible_with = PLATFORM_CONSTRAINTS[platform],
        target_compatible_with = PLATFORM_CONSTRAINTS[platform],
        toolchain = ":toolchain_impl_" + platform,
        toolchain_type = ":toolchain_type",
        visibility = ["//visibility:public"],
    )
    for platform in SUPPORTED_PLATFORMS
]
