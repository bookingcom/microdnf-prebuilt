load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "rpm2files_lib",
    srcs = ["main.go"],
    importpath = "github.com/bookingcom/microdnf-prebuilt/rpm2files",
    visibility = ["//visibility:private"],
    deps = ["@com_github_klauspost_compress//zstd"],
)

go_binary(
    name = "rpm2files",
    embed = [":rpm2files_lib"],
    pure = "on",
)

go_test(
    name = "rpm2files_test",
    srcs = ["main_test.go"],
    embed = [":rpm2files_lib"],
    pure = "on",
    deps = ["@com_github_klauspost_compress//zstd"],
)

filegroup(
    name = "all_files",
    srcs = glob(["*"]),
)
