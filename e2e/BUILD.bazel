load("@rules_bazel_integration_test//bazel_integration_test:defs.bzl", "bazel_integration_tests", "default_test_runner")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(default_visibility = ["//visibility:public"])

# Direct execution test for built tools
sh_test(
    name = "test_tools_test",
    srcs = ["test_tools.sh"],
    args = [
        "$(location //:microdnf)",
        "$(location //:rpm2archive)",
        "$(location //:dnf_lock)",
    ],
    data = [
        "//:dnf_lock",
        "//:microdnf",
        "//:rpm2archive",
    ],
)

# Downstream integration test driven by rules_bazel_integration_test
default_test_runner(
    name = "default_test_runner",
    bazel_cmds = [
        "info",
        "build //...",
        "test //...",
    ],
)

bazel_integration_tests(
    name = "downstream_e2e_tests",
    bazel_versions = ["9.3.0"],
    exec_properties = {
        "dockerNetwork": "bridge",
        "network": "bridge",
    },
    tags = [
        "requires-network",
    ],
    test_runner = ":default_test_runner",
    workspace_files = [
        "//:microdnf_module_files",
    ] + glob(
        ["smoke_test/**"],
        exclude = ["smoke_test/bazel-*/**"],
    ),
    workspace_path = "e2e/smoke_test",
)
