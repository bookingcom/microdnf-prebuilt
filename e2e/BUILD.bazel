load("@rules_bazel_integration_test//bazel_integration_test:defs.bzl", "bazel_integration_test", "default_test_runner")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//microdnf:defs.bzl", "rpm_archive", "rpm_extract", "rpm_lock")

package(default_visibility = ["//visibility:public"])

# Direct execution test for built tools
sh_test(
    name = "test_tools_test",
    srcs = ["test_tools.sh"],
    args = [
        "$(location //:microdnf)",
        "$(location //:rpm2archive)",
        "$(location //:dnf_lock)",
        "$(location //:rpm2files)",
    ],
    data = [
        "//:dnf_lock",
        "//:microdnf",
        "//:rpm2archive",
        "//:rpm2files",
    ],
)

# Step 2 test: Lockfile generation with RPM exclusion
rpm_lock(
    name = "test_generated_lock",
    arch = [
        "x86_64",
        "noarch",
    ],
    exclude = ["mystery-devel"],
    out = "test_generated_lock.lock.json",
    packages = ["tour"],
    releasever = "9",
    repo_config = "//e2e/testdata:test.repo",
    repo_files = ["//e2e/testdata:test_repo_files"],
)

sh_test(
    name = "rpm_lock_test",
    srcs = ["test_lock.sh"],
    args = [
        "$(location :test_generated_lock.lock.json)",
    ],
    data = [
        ":test_generated_lock.lock.json",
    ],
)

# Incremental lockfile tests
rpm_lock(
    name = "layer2_already_installed_lock",
    arch = [
        "x86_64",
        "noarch",
    ],
    lock_files = [":test_generated_lock.lock.json"],
    out = "layer2_already_installed.lock.json",
    packages = ["tour"],
    releasever = "9",
    repo_config = "//e2e/testdata:test.repo",
    repo_files = ["//e2e/testdata:test_repo_files"],
)

rpm_lock(
    name = "layer2_incremental_lock",
    arch = [
        "x86_64",
        "noarch",
    ],
    lock_files = [":test_generated_lock.lock.json"],
    out = "layer2_incremental.lock.json",
    packages = ["mystery-devel"],
    releasever = "9",
    repo_config = "//e2e/testdata:test.repo",
    repo_files = ["//e2e/testdata:test_repo_files"],
)

rpm_lock(
    name = "layer2_both_lock",
    arch = [
        "x86_64",
        "noarch",
    ],
    lock_files = [":test_generated_lock.lock.json"],
    out = "layer2_both.lock.json",
    packages = [
        "mystery-devel",
        "tour",
    ],
    releasever = "9",
    repo_config = "//e2e/testdata:test.repo",
    repo_files = ["//e2e/testdata:test_repo_files"],
)

rpm_lock(
    name = "changed_integrity_lock",
    arch = [
        "x86_64",
        "noarch",
    ],
    lock_files = ["//e2e/testdata:changed_integrity.lock.json"],
    out = "changed_integrity.lock.json",
    packages = ["tour"],
    releasever = "9",
    repo_config = "//e2e/testdata:test.repo",
    repo_files = ["//e2e/testdata:test_repo_files"],
)

sh_test(
    name = "incremental_lock_test",
    srcs = ["test_incremental_lock.sh"],
    args = [
        "$(location :layer2_already_installed.lock.json)",
        "$(location :layer2_incremental.lock.json)",
        "$(location :layer2_both.lock.json)",
        "$(location :changed_integrity.lock.json)",
    ],
    data = [
        ":changed_integrity.lock.json",
        ":layer2_already_installed.lock.json",
        ":layer2_both.lock.json",
        ":layer2_incremental.lock.json",
    ],
)

# Step 3 test: RPM proxy repository test
sh_test(
    name = "test_rpm_repository_test",
    srcs = ["test_rpm_repo.sh"],
    args = [
        "$(location @test_rpms//:tour)",
    ],
    data = [
        "@test_rpms//:tour",
    ],
)

# Step 4 test: Archive generation from RPM targets
rpm_archive(
    name = "tour_archive",
    compression = "gzip",
    rpm2archive_tool = "//:rpm2archive",
    rpms = ["@test_rpms//:tour"],
)

sh_test(
    name = "test_rpm_archive_test",
    srcs = ["test_archive.sh"],
    args = [
        "$(location :tour_archive)",
    ],
    data = [
        ":tour_archive",
    ],
)

rpm_archive(
    name = "whiteout_archive",
    compression = "gzip",
    obsolete_rpms = ["//e2e/testdata:repo/mystery-devel-19.67-1.noarch.rpm"],
    rpm2archive_tool = "//:rpm2archive",
    rpms = ["@test_rpms//:tour"],
    whiteouts = ["etc/custom_deleted_config.conf"],
)

sh_test(
    name = "test_rpm_whiteout_archive_test",
    srcs = ["test_whiteout_archive.sh"],
    args = [
        "$(location :whiteout_archive)",
    ],
    data = [
        ":whiteout_archive",
    ],
)

# Step 5 test: Extract files, dereference symlinks, mark executables
rpm_extract(
    name = "extracted_tour",
    archive = ":tour_archive",
    executables = [
        "usr/bin/away",
    ],
    files = [
        "etc/rollup",
        "usr/bin/away",
    ],
)

sh_test(
    name = "test_rpm_extract_test",
    srcs = ["test_extract.sh"],
    args = [
        "$(location :extracted_tour/usr/bin/away)",
        "$(location :extracted_tour/etc/rollup)",
    ],
    data = [
        ":extracted_tour",
        ":extracted_tour/etc/rollup",
        ":extracted_tour/usr/bin/away",
    ],
)

# Downstream integration test driven by rules_bazel_integration_test
default_test_runner(
    name = "default_test_runner",
    bazel_cmds = [
        "info",
        "build //...",
        "test //...",
    ],
)

config_setting(
    name = "is_linux_x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

config_setting(
    name = "is_linux_arm64",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
    ],
)

config_setting(
    name = "is_darwin_x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:macos",
    ],
)

config_setting(
    name = "is_darwin_arm64",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:macos",
    ],
)

# Bazel 9.3.1 for the host, from the pinned http_file repos in MODULE.bazel.
alias(
    name = "bazel_9_3_1",
    actual = select({
        ":is_linux_x86_64": "@bazel_9_3_1_linux_x86_64//file",
        ":is_linux_arm64": "@bazel_9_3_1_linux_arm64//file",
        ":is_darwin_x86_64": "@bazel_9_3_1_darwin_x86_64//file",
        ":is_darwin_arm64": "@bazel_9_3_1_darwin_arm64//file",
    }),
)

bazel_integration_test(
    name = "downstream_e2e_tests_bazel_9_3_1",
    timeout = "long",
    bazel_binary = ":bazel_9_3_1",
    # HOME is not inherited, so test-setup.sh points it at TEST_TMPDIR and the child Bazel
    # never reads the runner's ~/.bazelrc: setup-bazel writes `startup --output_base` there,
    # and the child would wait forever on the lock of the Bazel running this test.
    # (startup_options would not help: only the bazelisk wrapper of bazel_binaries reads
    # BIT_STARTUP_OPTIONS, and bazel_binary here is the plain pinned binary.)
    env_inherit = [
        "CC",
        "SUDO_ASKPASS",
    ],
    exec_properties = {
        "dockerNetwork": "bridge",
        "network": "bridge",
    },
    tags = [
        "requires-network",
    ],
    test_runner = ":default_test_runner",
    workspace_files = [
        "//:microdnf_module_files",
    ] + glob(
        ["smoke_test/**"],
        exclude = ["smoke_test/bazel-*/**"],
    ),
    workspace_path = "e2e/smoke_test",
)

test_suite(
    name = "downstream_e2e_tests",
    tests = [":downstream_e2e_tests_bazel_9_3_1"],
)

sh_test(
    name = "lock_direct_test",
    srcs = ["test_lock_direct.sh"],
    args = [
        "$(rootpath //:dnf_lock)",
        "$(rootpath //e2e/testdata:test.repo)",
        "$(rootpath //e2e/testdata:repo/repodata/repomd.xml)",
        "$(rootpath :test_generated_lock.lock.json)",
    ],
    data = [
        ":test_generated_lock.lock.json",
        "//:dnf_lock",
        "//e2e/testdata:repo/repodata/repomd.xml",
        "//e2e/testdata:test.repo",
        "//e2e/testdata:test_repo_files",
    ],
)

sh_test(
    name = "lock_layers_test",
    srcs = ["test_lock_layers.sh"],
    args = [
        "$(rootpath :test_lock_layers.py)",
        "$(rootpath //:dnf_lock)",
    ],
    data = [
        ":test_lock_layers.py",
        "//:dnf_lock",
    ],
)
