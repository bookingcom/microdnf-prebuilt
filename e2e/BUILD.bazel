# zstd-compressed layer: archive magic and extraction parity with the gzip variant
rpm_archive(
    name = "tour_archive_zstd",
    compression = "zstd",
    # the prebuilt rpm2archive predates zstd output, so build it from source here
    rpm2archive_tool = "//:rpm2archive",
    rpms = ["@test_rpms//:tour"],
)

rpm_extract(
    name = "extracted_tour_zstd",
    archive = ":tour_archive_zstd",
    executables = [
        "usr/bin/away",
    ],
    files = [
        "etc/rollup",
        "usr/bin/away",
    ],
)

sh_test(
    name = "test_rpm_extract_zstd_test",
    srcs = ["test_zstd.sh"],
    args = [
        "$(location :tour_archive_zstd)",
        "$(location :extracted_tour/usr/bin/away)",
        "$(location :extracted_tour/etc/rollup)",
        "$(location :extracted_tour_zstd/usr/bin/away)",
        "$(location :extracted_tour_zstd/etc/rollup)",
    ],
    data = [
        ":extracted_tour/etc/rollup",
        ":extracted_tour/usr/bin/away",
        ":extracted_tour_zstd/etc/rollup",
        ":extracted_tour_zstd/usr/bin/away",
        ":tour_archive_zstd",
    ],
)

# Downstream integration test driven by rules_bazel_integration_test
default_test_runner(
    name = "default_test_runner",
    bazel_cmds = [
        "info",
        "build //...",
        "test //...",
    ],
)

# Bazel 9.3.1 for the host, from the pinned http_file repos in MODULE.bazel.
alias(
    name = "bazel_9_3_1",
    actual = select({
        "@bazel_tools//src/conditions:linux_x86_64": "@bazel_9_3_1_linux_x86_64//file",
        "@bazel_tools//src/conditions:linux_aarch64": "@bazel_9_3_1_linux_arm64//file",
        "@bazel_tools//src/conditions:darwin_x86_64": "@bazel_9_3_1_darwin_x86_64//file",
        "@bazel_tools//src/conditions:darwin_arm64": "@bazel_9_3_1_darwin_arm64//file",
    }),
)

bazel_integration_test(
    name = "downstream_e2e_tests_bazel_9_3_1",
    timeout = "long",
    bazel_binary = ":bazel_9_3_1",
    # HOME is not inherited, so test-setup.sh points it at TEST_TMPDIR and the child Bazel
    # never reads the runner's ~/.bazelrc: setup-bazel writes `startup --output_base` there,
    # and the child would wait forever on the lock of the Bazel running this test.
    # (startup_options would not help: only the bazelisk wrapper of bazel_binaries reads
    # BIT_STARTUP_OPTIONS, and bazel_binary here is the plain pinned binary.)
    env_inherit = [
        "CC",
        "SUDO_ASKPASS",
    ],
    exec_properties = {
        "dockerNetwork": "bridge",
        "network": "bridge",
    },
    tags = [
        "requires-network",
    ],
    test_runner = ":default_test_runner",
    workspace_files = [
        "//:microdnf_module_files",
    ] + glob(
        ["smoke_test/**"],
        exclude = ["smoke_test/bazel-*/**"],
    ),
    workspace_path = "e2e/smoke_test",
)

test_suite(
    name = "downstream_e2e_tests",
    tests = [":downstream_e2e_tests_bazel_9_3_1"],
)

sh_test(
    name = "lock_direct_test",
    srcs = ["test_lock_direct.sh"],
