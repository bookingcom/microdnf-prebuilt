load("@rules_bazel_integration_test//bazel_integration_test:defs.bzl", "bazel_integration_test", "default_test_runner")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//microdnf:defs.bzl", "rpm_archive", "rpm_extract", "rpm_lock")
load(":repository_test.bzl", "repository_test_suite")
load(":rpm_listing.bzl", "rpm_listing")

package(default_visibility = ["//visibility:public"])

# Direct execution test for built tools
sh_test(
    name = "test_tools_test",
    srcs = ["test_tools.sh"],
    args = [
        "$(location //:microdnf)",
        "$(location //:rpm2archive)",
        "$(location //:dnf_lock)",
        "$(location //:rpm2files)",
    ],
    data = [
        "//:dnf_lock",
        "//:microdnf",
        "//:rpm2archive",
        "//:rpm2files",
    ],
)

# Step 2 test: Lockfile generation with RPM exclusion
rpm_lock(
    name = "test_generated_lock",
    arch = [
        "x86_64",
        "noarch",
    ],
    exclude = ["mystery-devel"],
    out = "test_generated_lock.lock.json",
    packages = ["tour"],
    releasever = "9",
    repo_config = "//e2e/testdata:test.repo",
    repo_files = ["//e2e/testdata:test_repo_files"],
)

sh_test(
    name = "rpm_lock_test",
    srcs = ["test_lock.sh"],
    args = [
        "$(location :test_generated_lock.lock.json)",
    ],
    data = [
        ":test_generated_lock.lock.json",
    ],
)

# dnf_lock features: --installroot, excludepkgs, modules, best/nobest, rich and weak deps
sh_test(
    name = "lock_features_test",
    srcs = ["test_lock_features.sh"],
    args = [
        "$(location //:dnf_lock)",
        "$(location //e2e/testdata:features-repo/repodata/repomd.xml)",
        "$(location //e2e/testdata:installroot/var/lib/rpm/rpmdb.sqlite)",
    ],
    data = [
        "//:dnf_lock",
        "//e2e/testdata:features-repo/repodata/repomd.xml",
        "//e2e/testdata:features_repo_files",
        "//e2e/testdata:installroot/var/lib/rpm/rpmdb.sqlite",
        "//e2e/testdata:installroot_files",
    ],
    # One section per shard (see SECTIONS in the script).
    shard_count = 8,
)

# rpm_lock on top of a parent image root, with dnf solver options
rpm_lock(
    name = "test_installroot_lock",
    arch = [
        "x86_64",
        "noarch",
    ],
    excludepkgs = ["ca-certificates-2026.2.92_v9.0.319-*"],
    installroot = "//e2e/testdata:installroot_files",
    module_enable = ["mysql:8.4"],
    out = "test_installroot_lock.lock.json",
    packages = [
        "app",
        "certuser",
        "mysql",
        "oldtool",
        "weakapp",
    ],
    releasever = "9",
    repo_config = "//e2e/testdata:features.repo",
    repo_files = ["//e2e/testdata:features_repo_files"],
)

sh_test(
    name = "rpm_lock_installroot_test",
    srcs = ["test_lock_installroot.sh"],
    args = [
        "$(location :test_installroot_lock.lock.json)",
    ],
    data = [
        ":test_installroot_lock.lock.json",
    ],
)

# installroot derived from anchors, whatever the shape of the input files
rpm_lock(
    name = "test_installroot_shape_rpmdb_only_lock",
    arch = [
        "x86_64",
        "noarch",
    ],
    installroot = "//e2e/testdata:installroot_rpmdb_only",
    out = "test_installroot_shape_rpmdb_only_lock.lock.json",
    packages = ["app"],
    releasever = "9",
    repo_config = "//e2e/testdata:features.repo",
    repo_files = ["//e2e/testdata:features_repo_files"],
)

rpm_lock(
    name = "test_installroot_shape_files_lock",
    arch = [
        "x86_64",
        "noarch",
    ],
    installroot = "//e2e/testdata:installroot_files",
    out = "test_installroot_shape_files_lock.lock.json",
    packages = ["app"],
    releasever = "9",
    repo_config = "//e2e/testdata:features.repo",
    repo_files = ["//e2e/testdata:features_repo_files"],
)

rpm_lock(
    name = "test_installroot_shape_sysimage_lock",
    arch = [
        "x86_64",
        "noarch",
    ],
    # Matches nothing; the apostrophe exercises shell quoting in the run script.
    excludepkgs = ["no-such'pkg-*"],
    installroot = "//e2e/testdata:sysimage_root",
    out = "test_installroot_shape_sysimage_lock.lock.json",
    packages = ["app"],
    releasever = "9",
    repo_config = "//e2e/testdata:features.repo",
    repo_files = ["//e2e/testdata:features_repo_files"],
)

rpm_lock(
    name = "test_installroot_shape_mixed_lock",
    arch = [
        "x86_64",
        "noarch",
    ],
    installroot = "//e2e/testdata:mixed_root",
    out = "test_installroot_shape_mixed_lock.lock.json",
    packages = ["app"],
    releasever = "9",
    repo_config = "//e2e/testdata:features.repo",
    repo_files = ["//e2e/testdata:features_repo_files"],
)

sh_test(
    name = "rpm_lock_installroot_shapes_test",
    srcs = ["test_lock_installroot_shapes.sh"],
    args = [
        "$(location :test_installroot_shape_rpmdb_only_lock.lock.json)",
        "$(location :test_installroot_shape_files_lock.lock.json)",
        "$(location :test_installroot_shape_sysimage_lock.lock.json)",
        "$(location :test_installroot_shape_mixed_lock.lock.json)",
    ],
    data = [
        ":test_installroot_shape_rpmdb_only_lock.lock.json",
        ":test_installroot_shape_files_lock.lock.json",
        ":test_installroot_shape_sysimage_lock.lock.json",
        ":test_installroot_shape_mixed_lock.lock.json",
    ],
)

# `bazel run` scripts of rpm_lock: same lockfile as the build action, from runfiles
sh_test(
    name = "rpm_lock_run_test",
    srcs = ["test_lock_run.sh"],
    args = [
        "test_generated_lock",
        "$(location :test_generated_lock.lock.json)",
        "test_installroot_lock",
        "$(location :test_installroot_lock.lock.json)",
        "test_installroot_shape_mixed_lock",
        "$(location :test_installroot_shape_mixed_lock.lock.json)",
        "test_installroot_shape_sysimage_lock",
        "$(location :test_installroot_shape_sysimage_lock.lock.json)",
    ],
    data = [
        ":test_generated_lock",
        ":test_generated_lock.lock.json",
        ":test_installroot_lock",
        ":test_installroot_lock.lock.json",
        ":test_installroot_shape_mixed_lock",
        ":test_installroot_shape_mixed_lock.lock.json",
        ":test_installroot_shape_sysimage_lock",
        ":test_installroot_shape_sysimage_lock.lock.json",
    ],
)

# rpm_repository BUILD generation: reserved 'transaction' name
repository_test_suite(name = "repository_unit_tests")

# Step 3 test: RPM proxy repository test
sh_test(
    name = "test_rpm_repository_test",
    srcs = ["test_rpm_repo.sh"],
    args = [
        "$(location @test_rpms//:tour)",
    ],
    data = [
        "@test_rpms//:tour",
    ],
)

# Step 4 test: Archive generation from RPM targets
rpm_archive(
    name = "tour_archive",
    compression = "gzip",
    rpms = ["@test_rpms//:tour"],
)

sh_test(
    name = "test_rpm_archive_test",
    srcs = ["test_archive.sh"],
    args = [
        "$(location :tour_archive)",
    ],
    data = [
        ":tour_archive",
    ],
)

# Transaction graph: weak deps, installed-root packages and satisfied requests
rpm_listing(
    name = "wapp_listing",
    rpm = "@test_transaction_rpms//:wapp",
)

rpm_listing(
    name = "transaction_listing",
    rpm = "@test_transaction_rpms//:transaction",
)

rpm_listing(
    name = "satisfied_listing",
    rpm = "@test_transaction_rpms//:satisfied",
)

rpm_archive(
    name = "satisfied_archive",
    compression = "gzip",
    rpms = ["@test_transaction_rpms//:satisfied"],
)

rpm_archive(
    name = "satisfied_zstd_archive",
    compression = "zstd",
    rpms = ["@test_transaction_rpms//:satisfied"],
)

sh_test(
    name = "test_transaction_test",
    srcs = ["test_transaction.sh"],
    args = [
        "$(location :wapp_listing)",
        "$(location :transaction_listing)",
        "$(location :satisfied_listing)",
        "$(location :satisfied_archive)",
        "$(location :satisfied_zstd_archive)",
    ],
    data = [
        ":satisfied_archive",
        ":satisfied_zstd_archive",
        ":satisfied_listing",
        ":transaction_listing",
        ":wapp_listing",
    ],
)

# Step 5 test: Extract files, dereference symlinks, mark executables
rpm_extract(
    name = "extracted_tour",
    archive = ":tour_archive",
    executables = [
        "usr/bin/away",
    ],
    files = [
        "etc/rollup",
        "usr/bin/away",
    ],
)

sh_test(
    name = "test_rpm_extract_test",
    srcs = ["test_extract.sh"],
    args = [
        "$(location :extracted_tour/usr/bin/away)",
        "$(location :extracted_tour/etc/rollup)",
    ],
    data = [
        ":extracted_tour",
        ":extracted_tour/etc/rollup",
        ":extracted_tour/usr/bin/away",
    ],
)

# zstd-compressed layer: archive magic and extraction parity with the gzip variant
rpm_archive(
    name = "tour_archive_zstd",
    compression = "zstd",
    rpms = ["@test_rpms//:tour"],
)

rpm_extract(
    name = "extracted_tour_zstd",
    archive = ":tour_archive_zstd",
    executables = [
        "usr/bin/away",
    ],
    files = [
        "etc/rollup",
        "usr/bin/away",
    ],
)

sh_test(
    name = "test_rpm_extract_zstd_test",
    srcs = ["test_zstd.sh"],
    args = [
        "$(location :tour_archive_zstd)",
        "$(location :extracted_tour/usr/bin/away)",
        "$(location :extracted_tour/etc/rollup)",
        "$(location :extracted_tour_zstd/usr/bin/away)",
        "$(location :extracted_tour_zstd/etc/rollup)",
    ],
    data = [
        ":extracted_tour/etc/rollup",
        ":extracted_tour/usr/bin/away",
        ":extracted_tour_zstd/etc/rollup",
        ":extracted_tour_zstd/usr/bin/away",
        ":tour_archive_zstd",
    ],
)

# Downstream integration test driven by rules_bazel_integration_test
default_test_runner(
    name = "default_test_runner",
    bazel_cmds = [
        "info",
        # `test //...` builds every target too; a separate build only adds a pass.
        "test //...",
    ],
)

config_setting(
    name = "is_linux_x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

config_setting(
    name = "is_linux_arm64",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
    ],
)

config_setting(
    name = "is_darwin_x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:macos",
    ],
)

config_setting(
    name = "is_darwin_arm64",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:macos",
    ],
)

# Bazel 9.3.1 for the host, from the pinned http_file repos in MODULE.bazel.
alias(
    name = "bazel_9_3_1",
    actual = select({
        ":is_linux_x86_64": "@bazel_9_3_1_linux_x86_64//file",
        ":is_linux_arm64": "@bazel_9_3_1_linux_arm64//file",
        ":is_darwin_x86_64": "@bazel_9_3_1_darwin_x86_64//file",
        ":is_darwin_arm64": "@bazel_9_3_1_darwin_arm64//file",
    }),
)

bazel_integration_test(
    name = "downstream_e2e_tests_bazel_9_3_1",
    timeout = "long",
    bazel_binary = ":bazel_9_3_1",
    exec_properties = {
        "dockerNetwork": "bridge",
        "network": "bridge",
    },
    startup_options = "--nohome_rc --nosystem_rc",
    tags = [
        "requires-network",
    ],
    test_runner = ":default_test_runner",
    workspace_files = [
        "//:microdnf_module_files",
    ] + glob(
        ["smoke_test/**"],
        exclude = ["smoke_test/bazel-*/**"],
    ),
    workspace_path = "e2e/smoke_test",
)

test_suite(
    name = "downstream_e2e_tests",
    tests = [":downstream_e2e_tests_bazel_9_3_1"],
)
