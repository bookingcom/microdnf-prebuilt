package(default_visibility = ["//visibility:public"])

# UBSan suppression file, present in the runfiles only under --config=asan.
_SANITIZER_DATA = select({
    "//sanitizers:enabled": ["//sanitizers:suppressions"],
    "//conditions:default": [],
})

# Direct execution test for built tools
sh_test(
    name = "test_tools_test",
    srcs = ["test_tools.sh"],
    args = [
        "$(location //:microdnf)",
        "$(location //:rpm2archive)",
        "$(location //:dnf_lock)",
        "$(location //:rpm2files)",
        "$(location //:mark)",
    ],
    data = [
        "//:dnf_lock",
        "//:mark",
        "//:microdnf",
        "//:rpm2archive",
        "//:rpm2files",
    ] + _SANITIZER_DATA,
)

# Step 2 test: Lockfile generation with RPM exclusion
rpm_lock(
    name = "test_generated_lock",
    arch = [
        "x86_64",
        "noarch",
    ],
    exclude = ["mystery-devel"],
    out = "test_generated_lock.lock.json",
    packages = ["tour"],
    releasever = "9",
    repo_config = "//e2e/testdata:test.repo",
    repo_files = ["//e2e/testdata:test_repo_files"],
)

sh_test(
    name = "rpm_lock_test",
    srcs = ["test_lock.sh"],
    args = [
        "$(location :test_generated_lock.lock.json)",
    ],
    data = [
        ":test_generated_lock.lock.json",
    ],
)

