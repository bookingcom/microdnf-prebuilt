module(
    name = "smoke_test",
    version = "0.0.1",
)

bazel_dep(name = "microdnf_prebuilt", version = "3.10.2")
local_path_override(
    module_name = "microdnf_prebuilt",
    path = "../..",
)

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_shell", version = "0.8.0")

tools = use_extension("@microdnf_prebuilt//microdnf:extensions.bzl", "tools")
tools.prebuilt(
    archive = "@microdnf_prebuilt//:microdnf_tools.tar.gz",
)
use_repo(tools, "microdnf_tools")
