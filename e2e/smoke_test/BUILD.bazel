load("@microdnf_prebuilt//microdnf:defs.bzl", "rpm_archive")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    "aarch64.lock.json",
    "tour-4-6.noarch.rpm",
    "x86_64.lock.json",
])

# Step 4 test: Create archive out of requested RPM targets and transitive dependencies
rpm_archive(
    name = "smoke_archive",
    compression = "gzip",
    rpms = ["@downstream_rpms//:tour"],
)

sh_test(
    name = "smoke_rpm_archive_test",
    srcs = ["test_archive.sh"],
    args = [
        "$(location :smoke_archive)",
    ],
    data = [
        ":smoke_archive",
    ],
)
