load("@rules_cc//cc:defs.bzl", "cc_library")

XB_PUBLIC_HDRS = [
    "src/xb-builder.h",
    "src/xb-builder-fixup.h",
    "src/xb-builder-node.h",
    "src/xb-builder-source.h",
    "src/xb-builder-source-ctx.h",
    "src/xb-compile.h",
    "src/xb-compile-glib-2-62.h",
    "src/xb-machine.h",
    "src/xb-node.h",
    "src/xb-node-query.h",
    "src/xb-node-silo.h",
    "src/xb-opcode.h",
    "src/xb-query.h",
    "src/xb-query-context.h",
    "src/xb-silo-export.h",
    "src/xb-silo.h",
    "src/xb-silo-query.h",
    "src/xb-stack.h",
    "src/xb-string.h",
    "src/xb-value-bindings.h",
    "src/xb-version.h",
]

cc_library(
    name = "xmlb_hdrs",
    hdrs = XB_PUBLIC_HDRS,
    include_prefix = "libxmlb",
    strip_include_prefix = "src",
)

cc_library(
    name = "libxmlb",
    srcs = [
        "config.h",
        "src/xb-builder.c",
        "src/xb-builder-fixup.c",
        "src/xb-builder-node.c",
        "src/xb-builder-source.c",
        "src/xb-builder-source-ctx.c",
        "src/xb-common.c",
        "src/xb-lzma-decompressor.c",
        "src/xb-machine.c",
        "src/xb-node.c",
        "src/xb-node-query.c",
        "src/xb-opcode.c",
        "src/xb-query.c",
        "src/xb-query-context.c",
        "src/xb-silo.c",
        "src/xb-silo-export.c",
        "src/xb-silo-node.c",
        "src/xb-silo-query.c",
        "src/xb-stack.c",
        "src/xb-string.c",
        "src/xb-value-bindings.c",
        "src/xb-version.c",
        "src/xb-zstd-decompressor.c",
    ] + glob(["src/*-private.h"]) + [
        "src/xb-lzma-decompressor.h",
        "src/xb-silo-node.h",
        "src/xb-zstd-decompressor.h",
    ],
    hdrs = ["src/xmlb.h"] + XB_PUBLIC_HDRS,
    copts = [
        "-Wno-unused-parameter",
        "-Wno-deprecated-declarations",
    ],
    includes = [
        ".",
        "src",
    ],
    deps = [
        ":xmlb_hdrs",
        "@glib//:gio",
        "@glib//:gio_unix",
        "@glib//:glib",
        "@glib//:gobject",
        "@xz//:lzma",
        "@zstd",
    ],
    visibility = ["//visibility:public"],
)
