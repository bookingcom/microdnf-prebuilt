mkenums(
    name = "as_enum_types_h",
    srcs = AS_PUB_HDRS,
    out = "src/as-enum-types.h",
    options = [
        "--fhead",
        "#pragma once\n\n#include <glib-object.h>\n\nG_BEGIN_DECLS\n",
        "--fprod",
        "\n/* enumerations from \"@basename@\" */\n",
        "--vhead",
        "GType @enum_name@_get_type (void);\n#define @ENUMPREFIX@_TYPE_@ENUMSHORT@ (@enum_name@_get_type())\n",
        "--ftail",
        "\nG_END_DECLS\n",
    ],
)

mkenums(
    name = "as_enum_types_c",
    srcs = AS_PUB_HDRS,
    out = "src/as-enum-types.c",
    options = [
        "--fhead",
        "#include \"as-enum-types.h\"\n",
        "--fprod",
        "\n/* enumerations from \"@basename@\" */\n#include \"@basename@\"\n",
        "--vhead",
        "GType\n@enum_name@_get_type (void)\n{\n  static gsize g_define_type_id__volatile = 0;\n  if (g_once_init_enter (&g_define_type_id__volatile)) {\n    static const G@Type@Value values[] = {\n",
        "--vprod",
        "      { @VALUENAME@, \"@VALUENAME@\", \"@valuenick@\" },\n",
        "--vtail",
        "      { 0, NULL, NULL }\n    };\n    GType g_define_type_id = g_@type@_register_static (g_intern_static_string (\"@EnumName@\"), values);\n    g_once_init_leave (&g_define_type_id__volatile, g_define_type_id);\n  }\n  return g_define_type_id__volatile;\n}\n",
    ],
)

GRESOURCE_FILES = [
    "data/xdg-category-names.txt",
    "data/iana-filtered-tld-list.txt",
    "data/platform_arch.txt",
    "data/platform_os.txt",
    "data/platform_env.txt",
    "data/reference-registries.txt",
]

glib_compile_resources(
    name = "as_resources_h",
    c_prefix = "as",
    internal = True,
    mode = "header",
    out = "src/as-resources.h",
    resources = GRESOURCE_FILES,
    xml = "src/appstream.gresource.xml",
)

glib_compile_resources(
    name = "as_resources_c",
    c_prefix = "as",
    internal = True,
    mode = "source",
    out = "src/as-resources.c",
    resources = GRESOURCE_FILES,
    xml = "src/appstream.gresource.xml",
)

gperf_header(
    name = "as_tag_xml_private_h",
