    name = "rpmio",
    srcs = [
        "rpm_config.h",
        "misc/fts.c",
        "rpmio/argv.c",
        "rpmio/base64.c",
        "rpmio/digest.c",
        "rpmio/digest_openssl.c",
        "rpmio/expression.c",
        "rpmio/lposix.c",
        "rpmio/macro.c",
        "rpmio/rgetopt.c",
        "rpmio/rpmfileutil.c",
        "rpmio/rpmglob.c",
        "rpmio/rpmhook.c",
        "rpmio/rpmio.c",
        "rpmio/rpmkeyring.c",
        "rpmio/rpmlog.c",
        "rpmio/rpmlua.c",
        "rpmio/rpmmalloc.c",
        "rpmio/rpmpgp.c",
        "rpmio/rpmpgp_internal.c",
        "rpmio/rpmsq.c",
