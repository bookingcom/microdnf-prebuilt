        "rpmio/rpmstrpool.c",
        "rpmio/rpmsw.c",
        "rpmio/rpmver.c",
        "rpmio/rpmvercmp.c",
        "rpmio/url.c",
    ],
    hdrs = glob(["include/rpm/*.h"]),
    local_defines = ["HAVE_CONFIG_H"],
    copts = [
        "-include",
        "rpm_config.h",
        "-Wno-unused-parameter",
        "-Wno-deprecated-declarations",
    ],
    includes = ["include"],
    linkopts = [
        "-lpthread",
        "-ldl",
        "-lm",
    ],
    deps = [
        ":rpm_headers",
