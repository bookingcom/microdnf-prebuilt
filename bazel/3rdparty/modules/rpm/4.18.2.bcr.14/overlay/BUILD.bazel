load("@rules_cc//cc:defs.bzl", "cc_library")

cc_library(
    name = "rpm_headers",
    hdrs = glob([
        "*.h",
        "include/rpm/*.h",
        "misc/*.h",
        "rpmio/*.h",
        "lib/*.h",
        "lib/backend/*.h",
        "lib/backend/ndb/*.h",
        "build/*.h",
        "sign/*.h",
    ]) + [
        "lib/tagtbl.C",
        "rpmio/modemuncher.c",
        "lib/rpmhash.C",
        "lib/rpmhash.H",
    ],
    includes = [
        ".",
        "include",
        "misc",
        "rpmio",
        "lib",
        "build",
        "sign",
    ],
)

