+
+const BuiltinEntry * try_find_builtin(const std::string & plugin_name) {
+    for (const auto & entry : builtin_entries) {
+        if (plugin_name == entry.get_name()) {
+            return &entry;
+        }
+    }
+    return nullptr;
+}
+
+const BuiltinEntry & find_builtin(const std::string & plugin_name) {
+    if (const auto * entry = try_find_builtin(plugin_name)) {
+        return *entry;
+    }
+    throw PluginError(M_("Plugin \"{}\" is not built in"), plugin_name);
+}
