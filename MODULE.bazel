module(
    name = "microdnf_prebuilt",
    version = "3.10.2",
)

# Core Bazel & platform dependencies from BCR (latest published versions)
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "platforms_contrib", version = "1.0.0-alpha.0", dev_dependency = True)
bazel_dep(name = "bazel_skylib", version = "1.9.2", dev_dependency = True)
bazel_dep(name = "bazel_lib", version = "3.7.2", dev_dependency = True)
bazel_dep(name = "rules_cc", version = "0.2.26", dev_dependency = True)
bazel_dep(name = "rules_shell", version = "0.8.0", dev_dependency = True)
bazel_dep(name = "tar.bzl", version = "0.10.9", dev_dependency = True)

# Hermetic Go toolchain for rpm2files from BCR
bazel_dep(name = "rules_go", version = "0.64.2", dev_dependency = True)

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk", dev_dependency = True)
go_sdk.from_file(go_mod = "//:go.mod")

# Go module dependencies of rpm2files (pure-Go zstd decoder)
bazel_dep(name = "gazelle", version = "0.54.0", dev_dependency = True)

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps", dev_dependency = True)
go_deps.from_file(go_mod = "//:go.mod")
use_repo(go_deps, "com_github_klauspost_compress")

# gazelle -> rules_apple -> rules_swift registers @build_bazel_rules_swift_local_config//:all, so
# toolchain resolution fetches it, and on a host with swiftc (GitHub ubuntu runners) its
# autoconfiguration compiles a Swift probe for 25-80 s. Nothing here is Swift: stand in an empty repo.
bazel_dep(name = "rules_swift", version = "3.1.2", dev_dependency = True)

empty_repository = use_repo_rule("//bazel:empty_repository.bzl", "empty_repository")

empty_repository(
    name = "no_swift_toolchains",
    dev_dependency = True,
)

swift_deps = use_extension("@rules_swift//swift:extensions.bzl", "non_module_deps", dev_dependency = True)

override_repo(swift_deps, build_bazel_rules_swift_local_config = "no_swift_toolchains")

# Hermetic Python 3.14 via aspect_rules_py from BCR
bazel_dep(name = "aspect_rules_py", version = "2.0.0-alpha.8", dev_dependency = True)

interpreters = use_extension(
    "@aspect_rules_py//py:extensions.bzl",
    "python_interpreters",
    dev_dependency = True,
)
interpreters.toolchain(python_version = "3.14")
use_repo(
    interpreters,
    "python_3_14_aarch64_apple_darwin",
    "python_3_14_aarch64_unknown_linux_gnu",
    "python_3_14_x86_64_apple_darwin",
    "python_3_14_x86_64_unknown_linux_gnu",
    "python_interpreters",
)

register_toolchains(
    "@python_interpreters//:all",
    dev_dependency = True,
)

# Hermetic LLVM C/C++ toolchain from BCR
bazel_dep(name = "llvm", version = "0.8.24", dev_dependency = True)

register_toolchains(
    "@llvm//toolchain:all",
    dev_dependency = True,
)

# Remote Execution Platform setup from BCR
bazel_dep(name = "toolchains_buildbuddy", version = "0.0.4", dev_dependency = True)

buildbuddy = use_extension(
    "@toolchains_buildbuddy//:extensions.bzl",
    "buildbuddy",
    dev_dependency = True,
)
buildbuddy.platform(
    buildbuddy_container_image = "UBUNTU24_04_IMAGE",
)
use_repo(buildbuddy, "buildbuddy_toolchain")

# BCR C/C++ leaf dependencies (latest versions in BCR)
bazel_dep(name = "pcre2", version = "10.49", dev_dependency = True)
bazel_dep(name = "libffi", version = "3.4.7.bcr.5", dev_dependency = True)
bazel_dep(name = "zlib", version = "1.3.2.bcr.2", dev_dependency = True)
bazel_dep(name = "bzip2", version = "1.0.8.bcr.4", dev_dependency = True)
bazel_dep(name = "xz", version = "5.4.5.bcr.9", dev_dependency = True)
bazel_dep(name = "zstd", version = "1.5.7.bcr.3", dev_dependency = True)
bazel_dep(name = "sqlite3", version = "3.53.4", dev_dependency = True)
bazel_dep(name = "libyaml", version = "0.2.5", dev_dependency = True)
bazel_dep(name = "libxml2", version = "2.15.3", dev_dependency = True)
bazel_dep(name = "libexpat", version = "2.8.3", dev_dependency = True)
bazel_dep(name = "openssl", version = "4.0.1.bcr.0", dev_dependency = True)
bazel_dep(name = "curl", version = "8.22.0", dev_dependency = True)
bazel_dep(name = "libarchive", version = "3.8.1.bcr.3", dev_dependency = True)

# Source-built C/C++ dependencies in bazel/3rdparty (<upstream_version>.bcr.<package-id>)
bazel_dep(name = "glib", version = "2.84.0.bcr.6", dev_dependency = True)
bazel_dep(name = "gobject-introspection", version = "1.84.0.bcr.7", dev_dependency = True)
bazel_dep(name = "libpeas", version = "1.36.0.bcr.12", dev_dependency = True)
bazel_dep(name = "smartcols", version = "2.41.0.bcr.3", dev_dependency = True)
bazel_dep(name = "libgpg-error", version = "1.51.0.bcr.5", dev_dependency = True)
bazel_dep(name = "libassuan", version = "3.0.2.bcr.8", dev_dependency = True)
bazel_dep(name = "gpgme", version = "1.24.2.bcr.11", dev_dependency = True)
bazel_dep(name = "popt", version = "1.19.0.bcr.7", dev_dependency = True)
bazel_dep(name = "file", version = "5.46.0.bcr.4", dev_dependency = True)
bazel_dep(name = "json-c", version = "0.18.0.bcr.3", dev_dependency = True)
bazel_dep(name = "rpm", version = "4.20.1.bcr.1", dev_dependency = True)
bazel_dep(name = "libsolv", version = "0.7.41.bcr.1", dev_dependency = True)
bazel_dep(name = "librepo", version = "1.21.2.bcr.1", dev_dependency = True)
bazel_dep(name = "libmodulemd", version = "2.15.0.bcr.15", dev_dependency = True)
bazel_dep(name = "libdnf", version = "0.74.0.bcr.28", dev_dependency = True)

# Enforce 1.51.0.bcr.5 across transitive 3rdparty dependencies (libassuan, librepo, gpgme)
single_version_override(
    module_name = "libgpg-error",
    version = "1.51.0.bcr.5",
)

# Enforce 1.21.2.bcr.1 across transitive 3rdparty dependencies (libdnf)
single_version_override(
    module_name = "librepo",
    version = "1.21.2.bcr.1",
)

# Enforce 0.7.41.bcr.1 across transitive 3rdparty dependencies (libdnf)
single_version_override(
    module_name = "libsolv",
    version = "0.7.41.bcr.1",
)

# Enforce 4.20.1.bcr.1 across transitive 3rdparty dependencies (libdnf, libsolv, libmodulemd)
single_version_override(
    module_name = "rpm",
    version = "4.20.1.bcr.1",
)

# Bazel Integration Tests
bazel_dep(name = "rules_bazel_integration_test", version = "0.37.1", dev_dependency = True)
bazel_dep(name = "cgrindel_bazel_starlib", version = "0.28.0", dev_dependency = True)

# Bazel for the downstream integration test, fetched (and cached) as a repo instead of
# bazelisk downloading it inside every test run.
http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

http_file(
    name = "bazel_9_3_1_linux_x86_64",
    dev_dependency = True,
    downloaded_file_path = "bazel",
    executable = True,
    sha256 = "7f775b54bbec487efaf0f49ccda1d2ed02cd34f582edfdd6aeeec76e39ef585c",
    url = "https://releases.bazel.build/9.3.1/release/bazel-9.3.1-linux-x86_64",
)

http_file(
    name = "bazel_9_3_1_linux_arm64",
    dev_dependency = True,
    downloaded_file_path = "bazel",
    executable = True,
    sha256 = "10ba9cb76d4ee748d274dcc2981992bb12b74a203dc41a9c2eceeb8f29359366",
    url = "https://releases.bazel.build/9.3.1/release/bazel-9.3.1-linux-arm64",
)

http_file(
    name = "bazel_9_3_1_darwin_x86_64",
    dev_dependency = True,
    downloaded_file_path = "bazel",
    executable = True,
    sha256 = "01eb4368a9c331391448bc1f11b1bec4e57793a0cee0581579ee786cd26baf37",
    url = "https://releases.bazel.build/9.3.1/release/bazel-9.3.1-darwin-x86_64",
)

http_file(
    name = "bazel_9_3_1_darwin_arm64",
    dev_dependency = True,
    downloaded_file_path = "bazel",
    executable = True,
    sha256 = "19c4958626e0e3a564a61c2e85eeaab97b550a30632b82341191aa61ed0ccc1b",
    url = "https://releases.bazel.build/9.3.1/release/bazel-9.3.1-darwin-arm64",
)

# Test RPM repository for e2e testing
rpm = use_extension("//microdnf:extensions.bzl", "rpm", dev_dependency = True)
rpm.repository(
    name = "test_rpms",
    lock_files = [
        "//e2e/testdata:x86_64.lock.json",
        "//e2e/testdata:aarch64.lock.json",
    ],
)
use_repo(rpm, "test_rpms")

# Upstream microdnf tracked as a bzlmod extension
microdnf = use_extension(
    "//bazel:extensions.bzl",
    "microdnf_extension",
    dev_dependency = True,
)
use_repo(microdnf, "microdnf_src")

# Prebuilt binary repositories and host alias repositories
microdnf_prebuilt = use_extension("//microdnf:extensions.bzl", "microdnf_prebuilt_extension")
use_repo(
    microdnf_prebuilt,
    "dnf_lock",
    "dnf_lock_linux_amd64",
    "dnf_lock_linux_arm64",
    "dnf_lock_osx_amd64",
    "dnf_lock_osx_arm64",
    "microdnf",
    "microdnf_linux_amd64",
    "microdnf_linux_arm64",
    "microdnf_osx_amd64",
    "microdnf_osx_arm64",
    "rpm2archive",
    "rpm2archive_linux_amd64",
    "rpm2archive_linux_arm64",
    "rpm2archive_osx_amd64",
    "rpm2archive_osx_arm64",
)

# Register prebuilt microdnf toolchains
register_toolchains(
    "//microdnf:toolchain_linux_amd64",
    "//microdnf:toolchain_linux_arm64",
    "//microdnf:toolchain_osx_amd64",
    "//microdnf:toolchain_osx_arm64",
    "//microdnf:toolchain_host",
)

