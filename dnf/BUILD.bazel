load("@bazel_lib//lib:transitions.bzl", "platform_transition_binary")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("//bazel:gresource.bzl", "glib_compile_resources")
load("//microdnf/private:platforms.bzl", "SUPPORTED_PLATFORMS")

package(default_visibility = ["//visibility:public"])

UPSTREAM_PLUGINS = [
    "install",
    "reinstall",
    "remove",
    "upgrade",
    "distrosync",
    "repolist",
    "repoquery",
    "leaves",
    "clean",
    "download",
    "makecache",
    "module_enable",
    "module_disable",
    "module_reset",
    "swap",
]

LOCAL_PLUGINS = [
    "rpm2archive",
    "lock",
]

[
    glib_compile_resources(
        name = "gresource_" + plugin,
        c_prefix = "dnf_command_" + plugin,
        out = "plugins/{}/dnf-command-{}.gresource.c".format(plugin, plugin),
        resources = ["@microdnf_src//:dnf/plugins/{}/{}.plugin".format(plugin, plugin)],
        xml = "@microdnf_src//:dnf/plugins/{}/dnf-command-{}.gresource.xml".format(plugin, plugin),
    )
    for plugin in UPSTREAM_PLUGINS
]

[
    glib_compile_resources(
        name = "gresource_" + plugin,
        c_prefix = "dnf_command_" + plugin,
        out = "plugins/{}/dnf-command-{}.gresource.c".format(plugin, plugin),
        resources = ["plugins/{}/{}.plugin".format(plugin, plugin)],
        xml = "plugins/{}/dnf-command-{}.gresource.xml".format(plugin, plugin),
    )
    for plugin in LOCAL_PLUGINS
]

COMMON_COPTS = [
    "--std=gnu11",
    "-fstrict-aliasing",
    "-Wformat=2",
    "-Wunused",
    "-Wuninitialized",
    "-Wstrict-prototypes",
    "-Wmissing-prototypes",
    "-Werror=implicit",
    "-Werror=init-self",
    "-Werror=main",
]

# C wrapper for libdnf C++-only API used by lock.c
cc_library(
    name = "lock_repo",
    srcs = ["lock-repo.cpp"],
    hdrs = ["lock-repo.h"],
    copts = [
        "-std=c++17",
        "-DLIBDNF_UNSTABLE_API",
    ],
    includes = ["."],
    deps = [
        "@glib//:glib",
        "@libdnf//:libdnf",
    ],
)

genrule(
    name = "copy_upstream_core",
    srcs = [
        "@microdnf_src//:dnf/dnf-command.c",
        "@microdnf_src//:dnf/dnf-command.h",
        "@microdnf_src//:dnf/dnf-utils.c",
        "@microdnf_src//:dnf/dnf-utils.h",
    ],
    outs = [
        "dnf-command.c",
        "dnf-command.h",
        "dnf-utils.c",
        "dnf-utils.h",
    ],
    cmd = "for f in $(SRCS); do cp $$f $(RULEDIR)/$$(basename $$f); done",
)

cc_binary(
    name = "microdnf",
    srcs = [
        ":copy_upstream_core",
        "dnf-main.c",
        "lock.c",
        "lock.h",
        "rpm2archive.c",
        "rpm2archive.h",
    ] + [
        "@microdnf_src//:dnf/plugins/{}/dnf-command-{}.c".format(plugin, plugin)
        for plugin in UPSTREAM_PLUGINS
    ] + [
        "@microdnf_src//:dnf/plugins/{}/dnf-command-{}.h".format(plugin, plugin)
        for plugin in UPSTREAM_PLUGINS
    ] + [
        ":gresource_" + plugin
        for plugin in UPSTREAM_PLUGINS
    ] + [
        "plugins/{}/dnf-command-{}.c".format(plugin, plugin)
        for plugin in LOCAL_PLUGINS
    ] + [
        "plugins/{}/dnf-command-{}.h".format(plugin, plugin)
        for plugin in LOCAL_PLUGINS
    ] + [
        ":gresource_" + plugin
        for plugin in LOCAL_PLUGINS
    ],
    copts = COMMON_COPTS,
    defines = [
        'PACKAGE_LIBDIR=\\"/usr/lib64/dnf\\"',
        'PACKAGE_DATADIR=\\"/usr/share/dnf\\"',
        'BUILDDIR=\\"dnf\\"',
        'SRCDIR=\\"dnf\\"',
    ],
    includes = ["."],
    linkopts = ["-rdynamic"],
    deps = [
        ":lock_repo",
        "@glib//:gio",
        "@glib//:glib",
        "@glib//:gobject",
        "@json-c//:json-c",
        "@libarchive//libarchive:archive",
        "@libdnf//:libdnf",
        "@libpeas//:libpeas",
        "@libsolv//:libsolv",
        "@rpm//:rpm",
        "@rpm//:rpmio",
        "@smartcols//:smartcols",
    ],
)

[
    platform_transition_binary(
        name = "microdnf_" + platform,
        binary = ":microdnf",
        target_platform = "//bazel:" + platform,
        tags = ["manual"],
    )
    for platform in SUPPORTED_PLATFORMS
]

filegroup(
    name = "microdnf_all",
    srcs = [
        ":microdnf_" + platform
        for platform in SUPPORTED_PLATFORMS
    ],
    tags = ["manual"],
)

cc_binary(
    name = "rpm2archive",
    srcs = [
        "rpm2archive.c",
        "rpm2archive.h",
        "rpm2archive-main.c",
    ],
    copts = COMMON_COPTS,
    includes = ["."],
    deps = [
        "@glib//:glib",
        "@libarchive//libarchive:archive",
        "@rpm//:rpm",
        "@rpm//:rpmio",
    ],
)

[
    platform_transition_binary(
        name = "rpm2archive_" + platform,
        binary = ":rpm2archive",
        target_platform = "//bazel:" + platform,
        tags = ["manual"],
    )
    for platform in SUPPORTED_PLATFORMS
]

filegroup(
    name = "rpm2archive_all",
    srcs = [
        ":rpm2archive_" + platform
        for platform in SUPPORTED_PLATFORMS
    ],
    tags = ["manual"],
)

cc_binary(
    name = "dnf_lock",
    srcs = [
        ":copy_upstream_core",
        "lock.c",
        "lock.h",
        "lock-main.c",
        "solve-arch.h",
    ],
    copts = COMMON_COPTS,
    defines = [
        'PACKAGE_LIBDIR=\\"/usr/lib64/dnf\\"',
        'PACKAGE_DATADIR=\\"/usr/share/dnf\\"',
        'BUILDDIR=\\"dnf\\"',
        'SRCDIR=\\"dnf\\"',
    ],
    includes = ["."],
    deps = [
        ":lock_repo",
        "@glib//:gio",
        "@glib//:glib",
        "@glib//:gobject",
        "@json-c//:json-c",
        "@libdnf//:libdnf",
        "@libsolv//:libsolv",
        "@rpm//:rpm",
        "@smartcols//:smartcols",
    ],
)

[
    platform_transition_binary(
        name = "dnf_lock_" + platform,
        binary = ":dnf_lock",
        target_platform = "//bazel:" + platform,
        tags = ["manual"],
    )
    for platform in SUPPORTED_PLATFORMS
]

filegroup(
    name = "dnf_lock_all",
    srcs = [
        ":dnf_lock_" + platform
        for platform in SUPPORTED_PLATFORMS
    ],
    tags = ["manual"],
)

cc_binary(
    name = "mark",
    srcs = [
        ":copy_upstream_core",
        "mark.c",
        "mark.h",
        "mark-main.c",
        "solve-arch.h",
    ],
    copts = COMMON_COPTS,
    defines = [
        'PACKAGE_LIBDIR=\\"/usr/lib64/dnf\\"',
        'PACKAGE_DATADIR=\\"/usr/share/dnf\\"',
        'BUILDDIR=\\"dnf\\"',
        'SRCDIR=\\"dnf\\"',
    ],
    includes = ["."],
    deps = [
        "@glib//:gio",
        "@glib//:glib",
        "@glib//:gobject",
        "@json-c//:json-c",
        "@libdnf//:libdnf",
        "@libsolv//:libsolv",
        "@rpm//:rpm",
        "@rpm//:rpmio",
        "@smartcols//:smartcols",
    ],
)

[
    platform_transition_binary(
        name = "mark_" + platform,
        binary = ":mark",
        target_platform = "//bazel:" + platform,
    )
    for platform in SUPPORTED_PLATFORMS
]

filegroup(
    name = "mark_all",
    srcs = [
        ":mark_" + platform
        for platform in SUPPORTED_PLATFORMS
    ],
)

alias(
    name = "rpmdb-mark",
    actual = ":mark",
)

[
    platform_transition_binary(
        name = "rpm2files_" + platform,
        binary = "//rpm2files:rpm2files",
        target_platform = "//bazel:" + platform,
        tags = ["manual"],
    )
    for platform in SUPPORTED_PLATFORMS
]

filegroup(
    name = "rpm2files_all",
    srcs = [
        ":rpm2files_" + platform
        for platform in SUPPORTED_PLATFORMS
    ],
    tags = ["manual"],
)

# Upstream's dnf5 with the lock command linked in, see dnf5/main.cpp (DNF5_BUILTIN_PLUGINS). Not called dnf5: the
# output file would be the directory of the sources in dnf5/.
cc_binary(
    name = "dnf5_binary",
    deps = [
        "@dnf5_src//:dnf5_main",
        "//dnf/dnf5:lock_plugin",
    ],
)

[
    platform_transition_binary(
        name = "dnf5_" + platform,
        binary = ":dnf5_binary",
        target_platform = "//bazel:" + platform,
    )
    for platform in SUPPORTED_PLATFORMS
]

filegroup(
    name = "dnf5_all",
    srcs = [
        ":dnf5_" + platform
        for platform in SUPPORTED_PLATFORMS
    ],
)
